# Only the new backend reads this file after it is copied to backend/.env.
DJANGO_SECRET_KEY=replace-with-at-least-50-cryptographically-random-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POSTGRES_DB=sporthub_next
POSTGRES_USER=sporthub_app
POSTGRES_PASSWORD=replace-with-a-new-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_SSLMODE=prefer
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=
# Enable only behind a trusted reverse proxy that overwrites forwarded headers.
DJANGO_TRUST_PROXY=false
